# Local development (node --env-file=.env dist/server/src/index.js, or export these).
# Without GOOGLE_* the login button shows "준비 중" and guest mode still works.
# Real Google login needs a public HTTPS origin (Google rejects private-IP redirect URIs).
PORT=5181
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORLD_SEED=worlds-v1
# WORLDS_DB=./data/worlds.db
# Test-only (never in production): WORLDS_AUTH_MOCK=1 WORLDS_TEST_MODE=1

# Cloudflare Realtime TURN (voice prayer rooms). Server-side only; never sent to clients.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Web Push (daily word, prayer reactions). Generate once: npx web-push generate-vapid-keys
# Leave empty to turn notifications off. Never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# 옷 그림 관리자 (M8): comma-separated verified Google emails that may review reported outfits.
# Leave empty for no admin. Everyone else gets 404 from /api/admin/*.
WORLDS_ADMIN_EMAILS=
