# Local development (node --env-file=.env dist/server/src/index.js, or export these).
# Without GOOGLE_* the login button shows "준비 중" and guest mode still works.
# Real Google login needs a public HTTPS origin (Google rejects private-IP redirect URIs).
PORT=5181
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORLD_SEED=worlds-v1
# WORLDS_DB=./data/worlds.db
# Test-only (never in production): WORLDS_AUTH_MOCK=1 WORLDS_TEST_MODE=1
